# Template for /home/ubuntu/cs-parser/.env on the VPS. Never commit the real one.
#
# Values are read by `docker compose --env-file`, which strips surrounding
# quotes — leave them off, including on the Accept-Encoding string.

# CI overwrites this line with the sha it just built.
PARSER_IMAGE=ghcr.io/mmaakkss/cs-skins-prices-parser:latest
PARSER_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=512m

# The parser's own database. DATABASE_URL is assembled from these in the
# compose file, so the credentials are written down once.
POSTGRES_USER=cs_parser
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=cs_parser

STEAM_REQUEST_DELAY=4.5
STEAM_ACCEPT_ENCODING=gzip;q=0.97, deflate
MARKET_CSGO_REQUEST_DELAY=0.25

# Optional: DMarket parsing stays disabled without these.
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=
